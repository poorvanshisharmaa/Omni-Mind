# All OmniMind settings are read with the OMNIMIND_ prefix (see app/config.py).
# Nothing here is required to run the app — every integration degrades to a
# harmless "not configured" no-op when its variables are unset.

# Jira integration — action items try Jira first, then fall back to GitHub.
OMNIMIND_JIRA_BASE_URL=
OMNIMIND_JIRA_EMAIL=
OMNIMIND_JIRA_API_TOKEN=
OMNIMIND_JIRA_PROJECT_KEY=

# GitHub integration — used as a fallback when Jira isn't configured.
OMNIMIND_GITHUB_TOKEN=
OMNIMIND_GITHUB_REPO=owner/repo

# Slack integration — posts a message per new action item.
OMNIMIND_SLACK_WEBHOOK_URL=
